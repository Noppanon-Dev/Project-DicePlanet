<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="30dp">

        <!-- ==================== HEADER ==================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="46dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="ย้อนกลับ" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="คลังบอร์ดเกม"
                android:textColor="@android:color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ==================== GAME IMAGE ==================== -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="166dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_game_detail_image">

            <ImageView
                android:id="@+id/imgGameDetail"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:src="@drawable/dixit"
                android:contentDescription="รูปบอร์ดเกม" />

        </FrameLayout>


        <!-- ==================== GAME NAME ==================== -->

        <TextView
            android:id="@+id/tvGameDetailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Dixit"
            android:textColor="@android:color/black"
            android:textSize="25sp"
            android:textStyle="bold" />


        <!-- ==================== CATEGORY ==================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvGameDetailCategory"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_category_orange"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="ปาร์ตี้"
                android:textColor="#333333"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvGameDetailGenre"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_category_purple"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="เล่าเรื่อง"
                android:textColor="#333333"
                android:textSize="11sp" />

        </LinearLayout>


        <!-- ==================== GAME INFO ==================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- ผู้เล่น -->

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_players"
                android:contentDescription="จำนวนผู้เล่น" />

            <TextView
                android:id="@+id/tvGameDetailPlayers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="3–4 คน"
                android:textColor="#555555"
                android:textSize="11sp" />

            <!-- เวลา -->

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="28dp"
                android:src="@drawable/ic_time"
                android:contentDescription="เวลาเล่น" />

            <TextView
                android:id="@+id/tvGameDetailTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="30–60 นาที"
                android:textColor="#555555"
                android:textSize="11sp" />

            <!-- อายุ -->

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="28dp"
                android:src="@drawable/ic_age"
                android:contentDescription="อายุผู้เล่น" />

            <TextView
                android:id="@+id/tvGameDetailAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="อายุ 8+"
                android:textColor="#555555"
                android:textSize="11sp" />

        </LinearLayout>


        <!-- ==================== DESCRIPTION ==================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="รายละเอียด"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGameDetailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text=""
            android:textColor="#444444"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />


        <!-- ==================== DIFFICULTY ==================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="ความยาก"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/bg_difficulty_active" />

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_difficulty_active" />

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_difficulty_active" />

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_difficulty_inactive" />

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_difficulty_inactive" />

        </LinearLayout>


        <!-- ==================== REVIEWS ==================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="รีวิวจากผู้เล่น"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <!-- คะแนน -->

            <LinearLayout
                android:layout_width="95dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGameRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.7"
                    android:textColor="@android:color/black"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★★★★☆"
                    android:textColor="#FFB13B"
                    android:textSize="16sp" />

            </LinearLayout>


            <!-- เส้นแบ่ง -->

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="12dp"
                android:background="#DDDDDD" />


            <!-- กราฟคะแนน -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 ★  ━━━━━━━━━ 95"
                    android:textColor="#777777"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4 ★  ━━━━━━━ 21"
                    android:textColor="#777777"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 ★  ━━━━━ 8"
                    android:textColor="#777777"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 ★  ━━━ 1"
                    android:textColor="#777777"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 ★  ━━━ 3"
                    android:textColor="#777777"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ==================== REVIEW BUTTON ==================== -->

        <TextView
            android:id="@+id/btnViewAllReviews"
            android:layout_width="155dp"
            android:layout_height="42dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_review_button"
            android:gravity="center"
            android:text="ดูรีวิวทั้งหมด    ›"
            android:textColor="#6D55C9"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>