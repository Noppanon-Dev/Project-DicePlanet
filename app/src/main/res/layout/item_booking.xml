<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bookingCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_booking_summary">

    <!-- แถวบน: เลขที่การจอง + สถานะ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvBookingId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="#DP00000000000"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBookingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="รอการยืนยัน"
            android:textColor="#F39C12"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- วันที่ -->
    <TextView
        android:id="@+id/tvBookingDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="5 กันยายน 2569"
        android:textColor="@android:color/black"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- เวลา -->
    <TextView
        android:id="@+id/tvBookingTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="20:00 - 22:00"
        android:textColor="#666666"
        android:textSize="14sp" />

    <!-- โต๊ะ -->
    <TextView
        android:id="@+id/tvBookingTable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="ชั้น 1 - A1"
        android:textColor="#666666"
        android:textSize="14sp" />

    <!-- เกม -->
    <TextView
        android:id="@+id/tvBookingGame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Dixit"
        android:textColor="#666666"
        android:textSize="14sp" />

    <!-- จำนวนคน -->
    <TextView
        android:id="@+id/tvBookingPlayers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="4 คน"
        android:textColor="#666666"
        android:textSize="14sp" />

    <!-- ปุ่ม -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnViewBooking"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="ดูรายละเอียด"
            android:textColor="@android:color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_booking_filter"
            android:clickable="true"
            android:focusable="true" />

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btnCancelBooking"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="ยกเลิกการจอง"
            android:textColor="#D64545"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_booking_filter"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>