<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="46dp"
        android:paddingBottom="20dp">

        <!-- หัวข้อ -->
        <TextView
            android:id="@+id/tvBoardgameTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="คลังบอร์ดเกม"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <!-- เว้นระยะ -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />


        <!-- ============================= -->
        <!-- Search + Filter -->
        <!-- ============================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Search Bar -->

            <LinearLayout
                android:id="@+id/searchContainer"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_search_bar"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/imgSearch"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="search" />

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:hint="ค้นหาเกม..."
                    android:autofillHints="none"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:inputType="text"
                    android:padding="0dp" />

            </LinearLayout>


            <!-- ช่องว่าง -->

            <Space
                android:layout_width="10dp"
                android:layout_height="match_parent" />


            <!-- ปุ่มกรองหมวดหมู่ -->

            <TextView
                android:id="@+id/tvCategoryFilter"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_booking_filter"
                android:gravity="center"
                android:text="☷"
                android:textColor="@android:color/black"
                android:textSize="22sp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>


        <!-- ============================= -->
        <!-- จำนวนเกม + เรียง -->
        <!-- ============================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- จำนวนเกม -->

            <TextView
                android:id="@+id/tvGameCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ทั้งหมด xx เกม"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- เรียงตาม -->

            <TextView
                android:id="@+id/tvSort"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="ความนิยม  ▾"
                android:textColor="#333333"
                android:textSize="13sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>


        <!-- ============================= -->
        <!-- รายการบอร์ดเกม -->
        <!-- ============================= -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerBoardgame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>

</ScrollView>