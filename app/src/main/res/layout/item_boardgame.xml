<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="horizontal"
    android:padding="10dp"
    android:background="@drawable/bg_boardgame_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- รูปบอร์ดเกม -->
    <ImageView
        android:id="@+id/imgGame"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:scaleType="centerCrop"
        android:src="@drawable/dice_planet_logo_nobg"
        android:contentDescription="รูปบอร์ดเกม" />

    <!-- ข้อมูลเกม -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <!-- ชื่อเกม -->
        <TextView
            android:id="@+id/tvGameName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dixit"
            android:textColor="@android:color/black"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- หมวดหมู่ -->
        <TextView
            android:id="@+id/tvGameCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="ปาร์ตี้"
            android:textColor="#333333"
            android:textSize="14sp" />

        <!-- จำนวนคน + เวลา -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- จำนวนผู้เล่น -->
            <ImageView
                android:id="@+id/imgPlayers"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_players"
                android:contentDescription="จำนวนผู้เล่น" />

            <TextView
                android:id="@+id/tvGamePlayers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="3–4 คน"
                android:textColor="#555555"
                android:textSize="12sp" />

            <!-- เว้นระยะระหว่างจำนวนคนกับเวลา -->
            <Space
                android:layout_width="14dp"
                android:layout_height="1dp" />

            <!-- เวลา -->
            <ImageView
                android:id="@+id/imgTime"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_time"
                android:contentDescription="เวลาเล่น" />

            <TextView
                android:id="@+id/tvGameTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="30–60 นาที"
                android:textColor="#555555"
                android:textSize="12sp" />
        </LinearLayout>
        <!-- คำอธิบาย -->
        <TextView
            android:id="@+id/tvGameDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="ตีความภาพและเรื่องราว พร้อมค้นหาคำใบ้เพื่อร่วมโต๊ะเดียวกัน"
            android:textColor="#555555"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>