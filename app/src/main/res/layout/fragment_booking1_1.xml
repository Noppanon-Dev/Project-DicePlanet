<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">


        <!-- ================================================= -->
        <!-- Header -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="การจอง"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="ย้อนกลับ"
                android:padding="8dp"
                android:src="@drawable/ic_back" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- Progress -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Step 1 -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_step_active"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@android:color/white"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="เลือกวันที่/เวลา"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- เส้น 1 → 2 -->

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="0.5"
                android:layout_marginStart="-10dp"
                android:layout_marginEnd="-10dp"
                android:background="#33000000" />


            <!-- Step 2 -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_step_inactive"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@android:color/white"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="เลือกโต๊ะ"
                    android:textSize="10sp" />

            </LinearLayout>


            <!-- เส้น 2 → 3 -->

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="0.5"
                android:layout_marginStart="-10dp"
                android:layout_marginEnd="-10dp"
                android:background="#33000000" />


            <!-- Step 3 -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_step_inactive"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@android:color/white"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="ยืนยันการจอง"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- เลือกวันที่ -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="เลือกวันที่"
            android:textSize="18sp"
            android:textStyle="bold" />


        <CalendarView
            android:id="@+id/calendarView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />


        <!-- วันที่เลือก -->

        <TextView
            android:id="@+id/tvSelectedDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="ยังไม่ได้เลือกวันที่"
            android:textSize="14sp" />


        <!-- ================================================= -->
        <!-- รูปแบบการเล่น -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="รูปแบบการเล่น"
            android:textSize="18sp"
            android:textStyle="bold" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="2">


            <!-- รายชั่วโมง -->

            <LinearLayout
                android:id="@+id/btnHourly"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_booking_option_selected"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/ivHourly"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="รายชั่วโมง"
                    android:src="@drawable/ic_hourly" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="รายชั่วโมง"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- เหมาวัน -->

            <LinearLayout
                android:id="@+id/btnFullDay"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_booking_option"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/ivFullDay"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="เหมาวัน"
                    android:src="@drawable/ic_full_day" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="เหมาวัน"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- Hourly Section -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/hourlySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="เลือกเวลา"
                android:textSize="18sp"
                android:textStyle="bold" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <Button
                    android:id="@+id/btnStartTime"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="20:00" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="ถึง"
                    android:textSize="14sp" />


                <Button
                    android:id="@+id/btnEndTime"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="22:00" />

            </LinearLayout>


            <TextView
                android:id="@+id/tvSelectedTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="เวลาที่เลือกคือ 20:00 - 22:00"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- Full Day Section -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/fullDaySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">


            <!-- ข้อมูลเหมาวัน -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/ivFullDaySection"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="4dp"
                    android:contentDescription="เหมาวัน"
                    android:src="@drawable/ic_full_day" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="เหมาทั้งวัน"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="สามารถใช้โต๊ะได้ตลอดเวลาที่ร้านเปิด"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- ราคา -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/ivPriceTag"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="4dp"
                    android:contentDescription="ราคา"
                    android:src="@drawable/ic_price_tag" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="ราคาเหมาวัน"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- จำนวนผู้เล่น -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="จำนวนผู้เล่น"
            android:textSize="18sp"
            android:textStyle="bold" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">


            <Button
                android:id="@+id/btnDecreasePlayer"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:text="−"
                android:textSize="22sp" />


            <TextView
                android:id="@+id/tvPlayerCount"
                android:layout_width="60dp"
                android:layout_height="52dp"
                android:gravity="center"
                android:text="0"
                android:textSize="18sp"
                android:textStyle="bold" />


            <Button
                android:id="@+id/btnIncreasePlayer"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:text="+"
                android:textSize="22sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- Next -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:text="ถัดไป"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>