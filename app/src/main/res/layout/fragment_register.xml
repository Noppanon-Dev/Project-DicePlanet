<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    android:id="@+id/registerScrollView"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#000000">

        <!-- พื้นที่สำหรับรูปตกแต่งด้านบน -->
        <FrameLayout
            android:id="@+id/decorationArea"
            android:layout_width="match_parent"
            android:layout_height="310dp">

            <!-- ปุ่มย้อนกลับ -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="50dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_arrow_back"
                app:tint="#FFFFFF"
                android:contentDescription="ย้อนกลับ"
                android:padding="12dp" />

            <!-- โลโก้ -->
            <ImageView
                android:id="@+id/imgRegisterLogo"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:src="@drawable/dice_planet_logo_nobg"
                android:contentDescription="Dice Planet Logo" />

            <!-- DICE -->
            <TextView
                android:id="@+id/tvDice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="180dp"
                android:text="DICE"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold" />

            <!-- PLANET -->
            <TextView
                android:id="@+id/tvPlanet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="220dp"
                android:text="PLANET"
                android:textColor="#8B5CF6"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- BOARD GAME AND CAFÉ -->
            <TextView
                android:id="@+id/tvBoardGameCafe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="260dp"
                android:text="BOARD GAME AND CAFÉ"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:letterSpacing="0.08"
                android:textStyle="normal" />

        </FrameLayout>


        <!-- กล่องสมัครสมาชิก -->
        <androidx.cardview.widget.CardView
            android:id="@+id/registerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:paddingTop="16dp"
                android:paddingBottom="12dp">

                <!-- หัวข้อ -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="สร้างบัญชี"
                    android:textColor="#000000"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="มาเริ่มการผจญภัยกับ Dice Planet กันเถอะ!"
                    android:textColor="#777777"
                    android:textSize="13sp" />


                <!-- Username -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_booking_option"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="10dp"
                        android:src="@drawable/ic_profile"
                        android:contentDescription="ชื่อผู้ใช้" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp">

                        <EditText
                            android:id="@+id/etName"
                            android:layout_width="match_parent"
                            android:layout_height="25dp"
                            android:background="@android:color/transparent"
                            android:hint="ชื่อผู้ใช้"
                            android:inputType="text"
                            android:singleLine="true"
                            android:textColor="#000000"
                            android:textColorHint="#333333"
                            android:textSize="12sp"
                            android:padding="0dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="อย่างน้อย 3 ตัวอักษร"
                            android:textColor="#999999"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>


                <!-- Email -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_booking_option"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="10dp"
                        android:src="@drawable/ic_email"
                        android:contentDescription="อีเมล" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp">

                        <EditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="25dp"
                            android:background="@android:color/transparent"
                            android:hint="อีเมล"
                            android:inputType="textEmailAddress"
                            android:singleLine="true"
                            android:textColor="#000000"
                            android:textColorHint="#333333"
                            android:textSize="12sp"
                            android:padding="0dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="กรุณาใช้ข้อมูลที่ใช้งานได้จริง"
                            android:textColor="#999999"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>


                <!-- Password -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_booking_option"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="10dp"
                        android:src="@drawable/ic_lock"
                        android:contentDescription="รหัสผ่าน" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp">

                        <EditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="25dp"
                            android:background="@android:color/transparent"
                            android:hint="รหัสผ่าน"
                            android:inputType="textPassword"
                            android:singleLine="true"
                            android:textColor="#000000"
                            android:textColorHint="#333333"
                            android:textSize="12sp"
                            android:padding="0dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="อย่างน้อย 6 ตัวอักษร"
                            android:textColor="#999999"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnShowPassword"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_visibility_off"
                        android:contentDescription="แสดงรหัสผ่าน"
                        android:padding="12dp" />

                </LinearLayout>


                <!-- Confirm Password -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_booking_option"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="10dp"
                        android:src="@drawable/ic_lock"
                        android:contentDescription="ยืนยันรหัสผ่าน" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp">

                        <EditText
                            android:id="@+id/etConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="25dp"
                            android:background="@android:color/transparent"
                            android:hint="ยืนยันรหัสผ่าน"
                            android:inputType="textPassword"
                            android:singleLine="true"
                            android:textColor="#000000"
                            android:textColorHint="#333333"
                            android:textSize="12sp"
                            android:padding="0dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="กรุณากรอกรหัสผ่านให้ตรงกัน"
                            android:textColor="#999999"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnShowConfirmPassword"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_visibility_off"
                        android:contentDescription="แสดงรหัสผ่าน"
                        android:padding="12dp" />

                </LinearLayout>


                <!-- ยอมรับเงื่อนไข -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/cbTerms"
                        android:layout_width="32dp"
                        android:layout_height="48dp"
                        android:padding="0dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ยอมรับ"
                        android:textColor="#555555"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTerms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ข้อกำหนดการใช้งาน"
                        android:textColor="#7350FF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingStart="3dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="และ"
                        android:textColor="#555555"
                        android:textSize="11sp"
                        android:paddingStart="3dp" />

                    <TextView
                        android:id="@+id/tvPrivacy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="นโยบายความเป็นส่วนตัว"
                        android:textColor="#7350FF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingStart="3dp" />

                </LinearLayout>


                <!-- ปุ่มสร้างบัญชี -->
                <TextView
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_login_button"
                    android:gravity="center"
                    android:text="สร้างบัญชี"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />


                <!-- หรือ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="25dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#DDDDDD" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:text="หรือ"
                        android:textColor="#777777"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#DDDDDD" />

                </LinearLayout>


                <!-- กลับไป Login -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="มีบัญชีอยู่แล้ว?"
                        android:textColor="#555555"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvLogin"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:paddingStart="5dp"
                        android:text="เข้าสู่ระบบ"
                        android:textColor="#7350FF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>